# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_SECRET=random_secret_for_internal_api

# Backend API
OMNIMAP_BACKEND_URL=http://omnimap-back:8000

# Frontend URL (for links in messages)
